# Do not use this file verbatim. Supply values through Render/Vercel secrets.
DEBUG=False
SECRET_KEY=generate-a-long-random-secret-at-least-50-characters
ALLOWED_HOSTS=tempotempo-api.onrender.com
CORS_ALLOWED_ORIGINS=https://your-production.vercel.app,https://your-approved-preview.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-production.vercel.app,https://your-approved-preview.vercel.app
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=True
JWT_ACCESS_MINUTES=10
USE_OBJECT_STORAGE=True
AWS_STORAGE_BUCKET_NAME=your-private-media-bucket
AWS_S3_REGION_NAME=your-region
SEED_DEMO=False
# Required only when SEED_DEMO=True. Never log this value.
DEMO_ADMIN_PASSWORD=
