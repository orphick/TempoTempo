SECRET_KEY=local-development-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Explicit origins only. Include the production Vercel origin and chosen preview origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Tehran
SERVE_MEDIA=True
JWT_ACCESS_MINUTES=10
# Production only: DEBUG=False, a random >=50-character SECRET_KEY, explicit HTTPS origins,
# SECURE_SSL_REDIRECT=True, and DEMO_ADMIN_PASSWORD only when SEED_DEMO=True.

# Use SQLite for local demos/tests. Set USE_SQLITE=False and fill PostgreSQL values for production-like runs.
USE_SQLITE=True
DATABASE_URL=
DB_NAME=tempotempo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
